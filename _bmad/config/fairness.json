{
  "discovery": {
    "mode": "structured",
    "principles": ["fairness", "efficiency", "accessibility", "automation"],
    "constraints": {
      "budget": "per-case fee model",
      "timeline": "MVP in 4 weeks",
      "team_size": "small team"
    }
  },
  "fairness_framework": {
    "principle": "balanced outcomes",
    "guidelines": [
