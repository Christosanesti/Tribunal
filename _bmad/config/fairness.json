  "user_journeys": {
    "claimant": ["sign up", "create case", "invite respondent", "upload documents", "mediate", "settle"],
    "respondent": ["receive invite", "sign up", "review case", "upload documents", "mediate", "settle"],
    "mediator": ["view assigned cases", "review evidence", "provide suggestions", "facilitate communication", "document settlement"],
    "admin": ["manage users", "view platform metrics", "manage mediators", "handle disputes"]
  },
  "monetization": {
    "models": ["per_case_fee", "mediator_subscription", "enterprise_api"],
    "pricing_tiers": {
      "free": "case creation only",
      "standard": "$29.99 per case",
      "premium": "$49.99 per case with mediator",
      "enterprise": "custom pricing for platforms"
    }
  }
